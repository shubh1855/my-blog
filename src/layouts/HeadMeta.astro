---
import type { PageMeta } from './page-meta';

interface Props {
  meta: PageMeta;
}

import { siteConfig } from '@constants/site-config';
import jetBrainsMonoLatinUrl from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import { getOgImageUrl } from '@lib/seo/og-image';
import { SEO } from 'astro-seo';
import { defaultLocale, getAlternateUrl, getHtmlLang, isI18nEnabled, localeList, localizedPath } from '@/i18n';

const { meta } = Astro.props;
const { locale, title, description, openGraph, robots, includeLocaleAlternates = true } = meta;

const resolveAbsoluteUrl = (value: string | undefined) => (value ? new URL(value, Astro.site).href : undefined);

const ogImage = resolveAbsoluteUrl(openGraph?.image) ?? getOgImageUrl(meta.coverImage, Astro.site);
const ogTitle = openGraph?.title ?? title;
const ogDescription = openGraph?.description ?? description;
const canonicalHref = meta.canonical ?? Astro.url.href;
const ogUrl = resolveAbsoluteUrl(openGraph?.url) ?? canonicalHref;

const keywords = meta.keywords || siteConfig.keywords || [siteConfig.title];
const rssFeeds = meta.rssFeeds ?? [
  { href: new URL(localizedPath('/rss.xml', locale), Astro.site).href, title: siteConfig.title },
];

const showLocaleAlternates = includeLocaleAlternates && isI18nEnabled;
const alternateUrl = (target: string) => new URL(getAlternateUrl(Astro.url.pathname, target), Astro.site).href;
const hreflangLinks = showLocaleAlternates
  ? localeList.map((loc) => ({ lang: getHtmlLang(loc), href: alternateUrl(loc) }))
  : [];
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

{/* Preload the primary font file to break the HTML→CSS→font network dependency chain.
    The browser discovers fonts only after parsing CSS; preloading eliminates that delay. */}
<link rel="preload" href={jetBrainsMonoLatinUrl} as="font" type="font/woff2" crossorigin="anonymous" />

{/* Preload the page's LCP image when the caller knows which image is above-the-fold.
    This eliminates resource-load delay by telling the browser before layout runs.
    Two preloads with media queries match the responsive <picture> in PostItemCard:
    mobile gets the smaller -mobile.webp, desktop gets the full-size .webp. */}
{meta.lcpImageUrl && (
  <>
    <link
      rel="preload"
      as="image"
      href={meta.lcpImageUrl.replace(/\.(webp)$/i, '-mobile.webp')}
      media="(max-width: 768px)"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href={meta.lcpImageUrl}
      media="(min-width: 769px)"
      fetchpriority="high"
    />
  </>
)}

<!-- SEO 元数据由 astro-seo 管理 -->
<SEO
  title={title}
  description={description}
  canonical={canonicalHref}
  openGraph={{
    basic: {
      title: ogTitle,
      type: openGraph?.type ?? 'website',
      image: ogImage || '',
      url: ogUrl,
    },
    optional: {
      siteName: siteConfig.name,
      description: ogDescription,
    },
  }}
  twitter={{
    card: ogImage ? 'summary_large_image' : 'summary',
    title: ogTitle,
    description: ogDescription,
    ...(ogImage && { image: ogImage }),
  }}
  extend={{
    meta: [{ name: 'author', content: siteConfig.author || '' }],
  }}
/>
{/* astro-seo 暂不支持管理 keywords */}
<meta name="keywords" content={keywords.join(', ')} />
{robots && <meta name="robots" content={robots} />}

{rssFeeds.map((feed) => (
  <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />
))}
{/* hreflang alternate links for SEO — only output when multiple locales are configured */}
{hreflangLinks.map(({ lang, href }) => (
  <link rel="alternate" hreflang={lang} href={href} />
))}
{showLocaleAlternates && <link rel="alternate" hreflang="x-default" href={alternateUrl(defaultLocale)} />}
