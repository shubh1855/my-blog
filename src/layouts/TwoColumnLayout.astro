---
import { MAX_WIDTH } from '@constants/layout';
import { cn } from '@lib/utils';
import type { BlogPost } from 'types/blog';
import Footer from '@/components/layout/Footer.astro';
import PostFooter from '@/components/post/PostFooter.astro';

interface Props {
  className?: string;
  post?: BlogPost;
  /** Moments and other utility pages do not need article-only related/random content. */
  showPostFooter?: boolean;
}

const { className, post, showPostFooter = true } = Astro.props;
---

<div class="flex flex-col">
  <slot name="cover" />
  <div class={cn('flex w-full items-start md:w-full', className)}>
    <slot name="sider" />
    <div class="flex min-w-0 grow flex-col gap-8 md:w-full max-w-[1024px] mx-auto">
      <slot />
      {showPostFooter && <PostFooter post={post} />}
      <Footer />
    </div>
  </div>
</div>
