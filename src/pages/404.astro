---
import geassSymbolSource from '@assets/svg/geass-symbol.svg?raw';
import geassSymbol from '@assets/svg/geass-symbol.svg?url';
import ButtonLink from '@components/control/ButtonLink.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import Cover from '@components/ui/cover/Cover.astro';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';
import { flapPose, wingFrames } from '@lib/geass-wing';
import { Icon } from 'astro-icon/components';
import { defaultLocale, getHtmlLang, localeList, localizedPath, t } from '@/i18n';

// Static hosts serve a single /404.html for every unknown URL, so this page cannot be
// pre-rendered per locale. It ships the default locale and re-localizes itself from
// the requested pathname on load (see the inline script at the end of the template).
const locale = defaultLocale;
const title = `404 - ${t(locale, 'notFound.title')}`;
const description = t(locale, 'notFound.description');

// The flapping Geass sigil: the site's own sigil path, with each horn bent about its neck
// at build time (see src/lib/geass-wing.ts). SVG interpolates between the frames, so the
// outline stays a single seamless shape while the wings swing up to vertical and back.
const sigilPath = geassSymbolSource.match(/\sd="([^"]+)"/)?.[1] ?? '';
const sigilFill = geassSymbolSource.match(/fill="([^"]+)"/)?.[1] ?? 'currentColor';
// Elbow sits ~2/3 along each horn; at full lift its 40° curl makes the two tips meet at the centre.
const WING_RIG = {
  axisX: 310.75,
  leftPivot: { x: 262, y: 286 },
  leftTip: { x: 84, y: 121 },
  ramp: 90,
  elbow: { at: 160, ramp: 40 },
};
// Animated "on twos" like the anime (24 fps, each drawing held for two frames): 12 held
// poses per second instead of a smooth 60 fps tween, so it reads as hand-drawn.
const FLAP_SECONDS = 1;
const DRAWINGS_PER_SECOND = 12;
const VERTICAL_DEG = 47; // horns point straight up
const DIP_DEG = -8; // small follow-through below rest
const TIP_CURL_DEG = 40; // elbow curl at full lift: the tips touch

// Neck (main wing) is slow and heavy; the tips curl faster within the same cycle (see flapPose).
const FLAP_TIMING = { verticalDeg: VERTICAL_DEG, dipDeg: DIP_DEG, curlDeg: TIP_CURL_DEG };
// One pose per drawing; `calcMode="discrete"` holds each until the next (no tweening).
const SAMPLES = Math.round(FLAP_SECONDS * DRAWINGS_PER_SECOND);
const keyTimes = Array.from({ length: SAMPLES }, (_, i) => i / SAMPLES);
const flapValues = wingFrames(
  sigilPath,
  WING_RIG,
  keyTimes.map((t) => flapPose(t, FLAP_TIMING)),
).join(';');
// Body rises as the wings push down, sinks as they lift.
const liftValues = keyTimes
  .map((t) => `0 ${(-5 * Math.sin(Math.PI * Math.min(1, Math.max(0, (t - 0.5) / 0.5)))).toFixed(2)}`)
  .join(';');
const keyTimesAttr = keyTimes.map((t) => t.toFixed(4)).join(';');

const localeCopy = Object.fromEntries(
  localeList.map((loc) => [
    loc,
    {
      htmlLang: getHtmlLang(loc),
      title: `404 - ${t(loc, 'notFound.title')}`,
      heading: t(loc, 'notFound.title'),
      message: t(loc, 'notFound.message'),
      backHome: t(loc, 'notFound.backHome'),
      browseArchives: t(loc, 'notFound.browseArchives'),
      homeHref: localizedPath('/', loc),
      archivesHref: localizedPath('/archives', loc),
    },
  ]),
);
---

<Layout locale={locale} title={title} description={description}>
  <TwoColumnLayout>
    <Cover slot="cover" title="404" />
    <HomeSider slot="sider" />
    <section class="geass-404 shadow-box bg-gradient-start" aria-labelledby="nf-heading">
      <div class="geass-stage" aria-hidden="true">
        <svg class="geass-sigil" viewBox="40 0 540 420" style={`--sigil-fill: ${sigilFill}`}>
          <g>
            <animateTransform attributeName="transform" type="translate" dur={`${FLAP_SECONDS}s`} repeatCount="indefinite" calcMode="discrete" keyTimes={keyTimesAttr} values={liftValues} />
            <path d={sigilPath}>
              <animate attributeName="d" dur={`${FLAP_SECONDS}s`} repeatCount="indefinite" calcMode="discrete" keyTimes={keyTimesAttr} values={flapValues} />
            </path>
          </g>
        </svg>
        <span class="sigil-shadow"></span>
      </div>

      <p class="nf-code">
        <img src={geassSymbol} alt="" width="18" height="12" class="nf-sigil" />
        <span>ERR · 404</span>
      </p>
      <h2 id="nf-heading" class="nf-heading" data-nf-text="heading">{t(locale, 'notFound.title')}</h2>
      <p class="nf-message" data-nf-text="message">{t(locale, 'notFound.message')}</p>

      <div class="nf-actions">
        <ButtonLink url={localizedPath('/', locale)} variant="gradient-shoka" size="lg" className="min-w-52 gap-2 font-bold shadow-md transition hover:brightness-110" data-nf-link="home">
          <Icon name="fa6-solid:house-chimney" aria-hidden="true" />
          <span data-nf-text="backHome">{t(locale, 'notFound.backHome')}</span>
        </ButtonLink>
        <ButtonLink
          url={localizedPath('/archives', locale)}
          variant="outline"
          size="lg"
          className="border-primary/40 text-primary hover:border-primary hover:text-primary min-w-52 gap-2 font-bold"
          data-nf-link="archives"
        >
          <Icon name="ri:archive-2-fill" aria-hidden="true" />
          <span data-nf-text="browseArchives">{t(locale, 'notFound.browseArchives')}</span>
        </ButtonLink>
      </div>
    </section>

    <script is:inline define:vars={{ localeCopy, defaultLocale }}>
      // The single pre-rendered 404.html must serve every locale, so resolve the locale
      // from the requested pathname and swap in the matching copy.
      (function () {
        function localize() {
          var segment = window.location.pathname.split('/').filter(Boolean)[0];
          var copy = localeCopy[segment && segment !== defaultLocale ? segment : defaultLocale];
          if (!copy) return;
          document.title = copy.title;
          document.documentElement.lang = copy.htmlLang;
          for (var node of document.querySelectorAll('[data-nf-text]')) {
            node.textContent = copy[node.dataset.nfText];
          }
          for (var link of document.querySelectorAll('[data-nf-link]')) {
            link.setAttribute('href', copy[link.dataset.nfLink + 'Href']);
          }
        }

        // SMIL ignores prefers-reduced-motion, so freeze the sigil at rest explicitly,
        // and pause it while it is scrolled out of view so it costs nothing off-screen.
        function respectMotion() {
          var sigil = document.querySelector('.geass-sigil');
          if (!sigil || sigil.dataset.motionReady) return;
          sigil.dataset.motionReady = 'true';
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            sigil.pauseAnimations();
            sigil.setCurrentTime(0);
            return;
          }
          if ('IntersectionObserver' in window) {
            new IntersectionObserver(function (entries) {
              if (entries[0].isIntersecting) sigil.unpauseAnimations();
              else sigil.pauseAnimations();
            }).observe(sigil);
          }
        }

        localize();
        respectMotion();
        document.addEventListener('astro:page-load', function () {
          localize();
          respectMotion();
        });
      })();
    </script>
  </TwoColumnLayout>
</Layout>

<style>
  .geass-404 {
    --nf-accent: hsl(var(--primary));
    --nf-glow: var(--color-pink);
    --nf-flap: 1s;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 2.5rem 1.5rem 3.5rem;
    text-align: center;
    overflow: hidden;
  }

  /* ── Sigil: wings flap about their shoulders ──── */
  .geass-stage {
    position: relative;
    display: grid;
    place-items: center;
    width: min(20rem, 80vw);
    margin: 0.5rem 0 1.5rem;
    /* Keep the per-frame path changes from invalidating layout/paint outside the sigil. */
    contain: layout paint style;
  }

  .geass-sigil {
    width: 100%;
    height: auto;
    overflow: visible;
    fill: var(--sigil-fill);
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--sigil-fill) 55%, transparent));
  }

  .sigil-shadow {
    width: 42%;
    height: 10px;
    margin-top: 0.75rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--sigil-fill) 45%, transparent), transparent);
    animation: shadow var(--nf-flap) steps(6, jump-start) infinite;
  }

  @keyframes shadow {
    0%,
    100% {
      scale: 1;
      opacity: 0.9;
    }
    50% {
      scale: 0.9;
      opacity: 0.7;
    }
  }

  /* ── Copy ────────────────────────────────────────── */
  .nf-code {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    color: hsl(var(--muted-foreground));
  }

  .nf-sigil {
    filter: drop-shadow(0 0 4px var(--nf-glow));
  }

  .nf-heading {
    font-size: 1.75rem;
    font-weight: 700;
    color: hsl(var(--primary));
    letter-spacing: 0.04em;
  }

  .nf-message {
    max-width: 32rem;
    color: hsl(var(--muted-foreground));
    font-size: 1rem;
    line-height: 1.7;
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .sigil-shadow {
      animation: none;
    }
  }
</style>
