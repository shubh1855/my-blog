---
import { EmbedHydrator } from '@components/embed/EmbedHydrator';
import ContentEnhancer from '@components/markdown/ContentEnhancer';
import type { ContentConfig } from '@constants/content-config';
import { defaultContentConfig } from '@constants/content-config';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { getLocaleFromUrl, t } from '@/i18n';

interface Props {
  Content?: AstroComponentFactory;
  config?: Partial<ContentConfig>;
}

const { Content, config = {} } = Astro.props;
const finalConfig = { ...defaultContentConfig, ...config };
const spoilerRevealLabel = t(getLocaleFromUrl(Astro.url.pathname), 'content.revealSpoiler');
---

<div
  class="custom-content"
  data-config={JSON.stringify(finalConfig)}
  data-spoiler-reveal-label={spoilerRevealLabel}
>
  {Content ? <Content /> : <slot />}
</div>

{/* React-based content enhancement (code blocks, mermaid, infographic toolbars) */}
{finalConfig.enhanceCodeBlock && (
  <ContentEnhancer
    client:idle
    enableCopy={finalConfig.enableCodeCopy}
    enableFullscreen={finalConfig.enableCodeFullscreen}
    enableQuiz={finalConfig.enableQuiz}
    enableEncryptedBlock={finalConfig.enableEncryptedBlock}
  />
)}

{/* Only load EmbedHydrator if tweet embeds are enabled (link previews are now server-rendered) */}
{finalConfig.enableTweetEmbed && <EmbedHydrator client:load />}

<script>
  import { enhanceImages } from '@lib/image-enhancer';
  import { enhanceLinkPreviews } from '@lib/link-preview-enhancer';
  import { enhanceSpoilers } from '@lib/spoiler-enhancer';

  // Content enhancement script - handles non-React enhancements
  function enhanceContent() {
    const contentContainer = document.querySelector('.custom-content');
    if (!contentContainer) return;

    // Keep this outside the general enhancement guard so a transient module-load
    // failure can retry without registering the other handlers again.
    enhanceSpoilers(contentContainer);

    // Avoid re-enhancing
    if (contentContainer.getAttribute('data-enhanced') === 'true') return;

    // Get configuration from data attribute
    const configData = contentContainer.getAttribute('data-config');
    const config = configData
      ? JSON.parse(configData)
      : { addBlankTarget: true, smoothScroll: true, addHeadingLevel: true };

    // Add target="_blank" to external links
    if (config.addBlankTarget) {
      const links = contentContainer.querySelectorAll('a[href]');
      links.forEach((link: Element) => {
        const anchor = link as HTMLAnchorElement;
        const href = anchor.getAttribute('href') || '';
        if (href.startsWith('http') || href.startsWith('//')) {
          anchor.setAttribute('target', '_blank');
        }
      });
    }

    // Add smooth scroll to anchor links
    if (config.smoothScroll) {
      const anchorLinks = contentContainer.querySelectorAll('a.anchor-link[href^="#"]');
      anchorLinks.forEach((link: Element) => {
        const anchor = link as HTMLAnchorElement;
        if (anchor.dataset.anchorReady === 'true') return;
        anchor.dataset.anchorReady = 'true';
        anchor.addEventListener('click', (e) => {
          if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          e.preventDefault();
          const targetId = anchor.getAttribute('href')?.substring(1);
          if (!targetId) return;
          const targetElement = document.getElementById(decodeURIComponent(targetId));
          if (targetElement) {
            targetElement.scrollIntoView({
              behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
              block: 'start',
            });
            if (location.hash !== `#${targetId}`) history.pushState(history.state, '', `#${targetId}`);
            if (!targetElement.hasAttribute('tabindex')) {
              targetElement.tabIndex = -1;
              targetElement.addEventListener('blur', () => targetElement.removeAttribute('tabindex'), { once: true });
            }
            targetElement.focus({ preventScroll: true });
          }
        });
      });
    }

    // Add heading level labels (H1, H2, etc.)
    if (config.addHeadingLevel) {
      const headings = contentContainer.querySelectorAll('h1, h2, h3, h4, h5, h6');
      headings.forEach((heading: Element) => {
        const level = heading.tagName[1];
        heading.setAttribute('data-level', `H${level}`);
      });
    }

    // Enhance images with loading states
    enhanceImages(contentContainer);

    // Enhance link preview images with error handling
    enhanceLinkPreviews(contentContainer);

    // Scope each group to its own controls, so nested tabs stay independent.
    contentContainer.querySelectorAll<HTMLElement>('.tab-group').forEach((group, groupIndex) => {
      const own = (selector: string) => Array.from(group.querySelectorAll<HTMLElement>(selector))
        .filter((node) => node.closest('.tab-group') === group);
      const headers = own('.tab-header[role="tab"]');
      const panels = own('.tab-panel');
      const activate = (header: HTMLElement) => {
        for (const tab of headers) {
          const selected = tab === header;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
        }
        for (const panel of panels) {
          const selected = panel.dataset.tabIndex === header.dataset.tabIndex;
          panel.classList.toggle('active', selected);
          panel.hidden = !selected;
        }
      };
      headers.forEach((header, index) => {
        if (header.dataset.tabReady === 'true') return;
        header.dataset.tabReady = 'true';
        header.id ||= `content-tab-${groupIndex}-${index}`;
        const panel = panels.find((item) => item.dataset.tabIndex === header.dataset.tabIndex);
        if (panel) {
          panel.id ||= `${header.id}-panel`;
          panel.setAttribute('role', 'tabpanel');
          panel.setAttribute('aria-labelledby', header.id);
          panel.tabIndex = 0;
          header.setAttribute('aria-controls', panel.id);
        }
        header.addEventListener('click', () => activate(header));
        header.addEventListener('keydown', (event) => {
          let next: number;
          switch (event.key) {
            case 'ArrowRight': next = (index + 1) % headers.length; break;
            case 'ArrowLeft': next = (index - 1 + headers.length) % headers.length; break;
            case 'Home': next = 0; break;
            case 'End': next = headers.length - 1; break;
            default: return;
          }
          event.preventDefault();
          activate(headers[next]);
          headers[next].focus();
        });
      });
      if (headers.length) activate(headers.find((header) => header.getAttribute('aria-selected') === 'true') ?? headers[0]);
    });

    contentContainer.querySelectorAll<HTMLElement>('.spoiler.blur').forEach((spoiler) => {
      if (spoiler.dataset.blurReady === 'true') return;
      spoiler.dataset.blurReady = 'true';
      spoiler.setAttribute('role', 'button');
      spoiler.tabIndex = 0;
      const toggle = () => {
        const revealed = spoiler.classList.toggle('revealed');
        spoiler.setAttribute('aria-expanded', String(revealed));
        if (revealed) spoiler.removeAttribute('aria-label');
        else spoiler.setAttribute('aria-label', contentContainer.getAttribute('data-spoiler-reveal-label') ?? 'Reveal spoiler');
      };
      spoiler.setAttribute('aria-expanded', String(spoiler.classList.contains('revealed')));
      if (!spoiler.classList.contains('revealed')) {
        spoiler.setAttribute('aria-label', contentContainer.getAttribute('data-spoiler-reveal-label') ?? 'Reveal spoiler');
      }
      spoiler.addEventListener('click', toggle);
      spoiler.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        toggle();
      });
    });

    // Mark as enhanced
    contentContainer.setAttribute('data-enhanced', 'true');
  }

  // Run on page load
  document.addEventListener('astro:page-load', () => {
    const contentContainer = document.querySelector('.custom-content');
    if (contentContainer) {
      contentContainer.removeAttribute('data-enhanced');
    }
    enhanceContent();
  });

  // Re-enhance after encrypted post decryption (new DOM needs external links, anchors, etc.)
  document.addEventListener('content:decrypted', () => {
    const contentContainer = document.querySelector('.custom-content');
    if (contentContainer) {
      contentContainer.removeAttribute('data-enhanced');
    }
    enhanceContent();
  });

  // Run immediately if already loaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', enhanceContent);
  } else {
    enhanceContent();
  }
</script>
