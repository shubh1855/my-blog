---
export interface Props {
  className?: string;
  /**
   * 翻转方向
   * @default 'horizontal'
   */
  direction?: 'horizontal' | 'vertical';
  /**
   * 翻转动画时长(ms)
   * @default 600
   */
  duration?: number;
  /**
   * 防误触延迟(ms)，hover 后等待一段时间再翻转
   * @default 100
   */
  delay?: number;
  /**
   * 是否禁用翻转
   * @default false
   */
  disabled?: boolean;
}

const { className, direction = 'horizontal', duration = 600, delay = 100, disabled = false } = Astro.props;
---

<div class:list={['flip-card h-56', className, { 'flip-card-disabled': disabled }]} data-direction={direction}>
  <div class="flip-card-inner">
    <div class="flip-card-front">
      <slot name="front" />
    </div>
    <div class="flip-card-back" inert aria-hidden="true">
      <slot name="back" />
    </div>
  </div>
</div>

<style define:vars={{ duration, delay }}>
  .flip-card {
    position: relative;
    background-color: transparent;
    perspective: 1000px;
  }

  /* 透明覆盖层，确保 hover 检测区域稳定，不受 3D 变换影响 */
  .flip-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;
  }

  .flip-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    text-align: center;
    transition: transform calc(var(--duration) * 1ms);
    transform-style: preserve-3d;
    will-change: transform;
    pointer-events: none;
  }

  .flip-card:not(.flip-card-disabled)[data-revealed] .flip-card-inner {
    transform: rotateY(-180deg);
    transition-delay: calc(var(--delay) * 1ms);
  }

  .flip-card-front,
  .flip-card-back {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transform-style: preserve-3d;
    border-radius: 0.5rem;
    pointer-events: auto;
  }

  .flip-card-front {
    z-index: 2;
  }

  .flip-card-back {
    transform: rotateY(-180deg);
  }

  .flip-card-disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  /* 添加一些过渡效果 */
  .flip-card-front,
  .flip-card-back {
    transition: all calc(var(--duration) * 1ms) ease-in-out;
  }

  /* 添加阴影效果 */
  .flip-card:not(.flip-card-disabled):hover .flip-card-front {
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  }

  .flip-card:not(.flip-card-disabled):hover .flip-card-back {
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  }

  @media (prefers-reduced-motion: reduce) {
    .flip-card-inner,
    .flip-card-front,
    .flip-card-back {
      transition: none;
    }
    .flip-card[data-revealed] .flip-card-inner {
      transition-delay: 0ms;
    }
  }
</style>

<script>
  function initFlipCards() {
    document.querySelectorAll<HTMLElement>('.flip-card:not(.flip-card-disabled)').forEach((card) => {
      if (card.dataset.initialized) return;
      const front = card.querySelector<HTMLElement>('.flip-card-front');
      const back = card.querySelector<HTMLElement>('.flip-card-back');
      if (!front || !back) return;
      card.dataset.initialized = 'true';
      let hovered = false;

      const update = () => {
        // Never turn a focused link onto an invisible face.
        const frontFocused = front.contains(document.activeElement);
        const revealed = !frontFocused && (hovered || back.contains(document.activeElement));
        card.toggleAttribute('data-revealed', revealed);
        front.inert = revealed;
        front.setAttribute('aria-hidden', String(revealed));
        back.inert = !revealed;
        back.setAttribute('aria-hidden', String(!revealed));
      };

      card.addEventListener('pointerenter', (event) => {
        if (event.pointerType !== 'mouse') return;
        hovered = true;
        update();
      });
      card.addEventListener('pointerleave', () => {
        hovered = false;
        update();
      });
      card.addEventListener('focusin', update);
      card.addEventListener('focusout', () => queueMicrotask(update));
      card.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !card.hasAttribute('data-revealed')) return;
        event.preventDefault();
        hovered = false;
        front.inert = false;
        front.setAttribute('aria-hidden', 'false');
        front.querySelector<HTMLElement>('a[href]')?.focus();
        update();
      });
    });
  }

  initFlipCards();
  document.addEventListener('astro:page-load', initFlipCards);
</script>
